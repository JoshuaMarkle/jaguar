#!/bin/sh
# Reference-hull guard: block a commit that changes in.mlt / off1.mlt / out.mlt
# unless the pinned SHA-256 manifest is updated to match (i.e. an intentional
# hull redesign).  Accidental in-repo Godzilla/sweep overwrites are stopped
# before they land.
#
# Install once (per clone):
#     git config core.hooksPath .githooks
#
# CI enforces the same check via tests/test_reference_hull_integrity.py, so this
# hook is a local convenience that saves a round-trip; skipping it does not let
# corruption reach main.

manifest="tests/fixtures/reference_hull.sha256"
staged="$(git diff --cached --name-only)"
fail=0

for f in in.mlt off1.mlt out.mlt; do
    printf '%s\n' "$staged" | grep -qx "$f" || continue
    want="$(grep " $f\$" "$manifest" 2>/dev/null | awk '{print $1}')"
    have="$(git show ":$f" | sha256sum | awk '{print $1}')"
    if [ "$want" != "$have" ]; then
        echo "pre-commit: staged '$f' does not match its pinned SHA-256."
        fail=1
    fi
done

if [ "$fail" = 1 ]; then
    echo ""
    echo "The tracked reference hull changed.  If a sweep/Godzilla run corrupted"
    echo "it, restore:   git checkout -- in.mlt off1.mlt out.mlt"
    echo "If intentional, regenerate the manifest in this commit:"
    echo "    sha256sum in.mlt off1.mlt out.mlt > $manifest"
    exit 1
fi
