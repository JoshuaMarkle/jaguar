# Python caches
__pycache__/
*.pyc

# Virtual environments
venv/
clean_build_env/

# PyInstaller build folders
build/
dist/
*.spec
# ...but the packaging recipes are SOURCE, not generated. `*.spec` exists to
# ignore the spec PyInstaller drops in the root when you run it against a
# script; packaging/ holds the hand-written build definitions, and without
# them in the repo nobody else can build the application at all.
!packaging/*.spec

# Windows/Mac system files
.DS_Store
Thumbs.db

# SQLite write-ahead-log sidecars — transient, recreated whenever the mix
# database is opened.  Tracking them makes every app/test run look dirty.
*.db-shm
*.db-wal

# Generated ASCE report PDFs — rewritten by every structural sweep
# (main.run_grand_optimization) and by the compliance report generator.
# Build artifacts, not source: untracked so a real sweep no longer dirties
# the repo.
ASCE_Moment_Envelope.pdf
ASCE_Shear_Envelope.pdf
ASCE_Pour_Zones.pdf
ASCE_Utilization.pdf
ASCE_Optimized_Hull.pdf
ASCE_Technical_Submittal.pdf

# Mix development target spec — regenerated by every sweep alongside the PDFs
# above (same reports_dir anchor, which defaults to the project root).  It is
# the current answer to "what should the mix team develop next", so it is
# reproducible output, not source.
mix_development_targets.txt

# LaTeX report output directories — the .tex, its figures and the compiled PDF
# are all regenerated by generate_latex_report() on every run. Build artifacts,
# not source: the report is reproducible from the sweep result.
pipeline_output/
reports/

# Godzilla/Michlet optimizer outputs — regenerated whenever mlt933w.exe runs,
# and read by NO app code (the sweep consumes only off1.mlt + out.mlt, which
# stay tracked as the reference hull).  Listed EXPLICITLY, never *.mlt, so the
# tracked inputs off1.mlt / out.mlt / inTemplate.mlt / in.mlt are never caught.
# Godzilla scratch working directory — HullService.launch_godzilla runs the
# binary in here so a crashed or cancelled run cannot half-write the TRACKED
# reference hull (off1.mlt / out.mlt), which are promoted out only on a clean
# exit.  Everything inside is regenerated per run.
godzilla_run/

off2.mlt
off3.mlt
off4.mlt
off5.mlt
godzout.mlt
drag.mlt
drdth.mlt
hsecarea.mlt
hwparea.mlt
lcut.mlt
rcut.mlt
tcut.mlt
recpatch.mlt
secpatch.mlt
recpatch.pcx
secpatch.pcx
ship_output_by_speed.mlt
fsoff1.txt
fsoff2.txt
fsoff3.txt
fsoff4.txt
fsoff5.txt
mlt.log
firm.log

# App session state and run logs — rewritten every sweep / pipeline save,
# so tracking them made routine app use dirty the repo.
design_state.json
sweep_audit.log
# Timestamped mix-database backups the app writes before a risky import.
*.db.bak-*
validation_results.json
_DEBUG_LOG
replay_debug.txt
