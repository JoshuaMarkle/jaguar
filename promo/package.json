{
  "name": "jaguar-promo",
  "private": true,
  "version": "0.1.0",
  "description": "JAGUAR promo video as code (Remotion). Every number, curve and hull comes from promo/data (JAGUAR output).",
  "scripts": {
    "extract": "node scripts/extract.mjs",
    "studio": "remotion studio",
    "still": "remotion still",
    "render": "remotion render JaguarPromo out/jaguar-promo.mp4",
    "render:vertical": "remotion render JaguarPromoVertical out/jaguar-promo-vertical.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "@remotion/cli": "4.0.530",
    "@remotion/three": "4.0.530",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.530",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "5.9.3"
  }
}
